MONGO_URI=mongodb://localhost:27017/campus_crave
PORT=5000
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5000
# Use a public URL (for example from ngrok) so Twilio can fetch PDF files.
PUBLIC_BASE_URL=https://your-public-domain-or-ngrok-url
ADMIN_WHATSAPP_NUMBER=9879929804
ADMIN_EMAIL=admin@campus.com
ADMIN_PASSWORD=admin123

# Email Configuration (for bill sending)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# WhatsApp Integration (Twilio)
# To enable WhatsApp: 
# 1. Sign up at https://www.twilio.com
# 2. Get your Account SID and Auth Token
# 3. Get a WhatsApp-enabled Twilio phone number
# 4. Fill these values below
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671
