MONGO_URI=mongodb://localhost:27017/campus_crave
PORT=5000
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5000
ENABLE_ONLINE_PAYMENTS=false
ENABLE_SMTP_EMAILS=false
ENFORCE_REGISTRATION_EMAIL=true
# Use a public URL (for example from ngrok) so Twilio can fetch PDF files.
PUBLIC_BASE_URL=https://your-public-domain-or-ngrok-url
ADMIN_WHATSAPP_NUMBER=9879929804
ADMIN_EMAIL=admin@campus.com
ADMIN_PASSWORD=admin123

# Email Configuration Option A: SMTP (Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Email Configuration Option 0: Resend API (recommended, no SMTP required)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=CampusCrave

# Email Configuration Option B: Brevo API (no Gmail app password required)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your-verified-sender@domain.com
EMAIL_FROM_NAME=CampusCrave

# WhatsApp Integration (Twilio)
# To enable WhatsApp: 
# 1. Sign up at https://www.twilio.com
# 2. Get your Account SID and Auth Token
# 3. Get a WhatsApp-enabled Twilio phone number
# 4. Fill these values below
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR
